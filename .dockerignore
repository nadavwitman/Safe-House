# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Dev / test files
Backend_Server/tests/
Backend_Server/scripts/

# Virtual environment
Backend_Server/venv/
Backend_Server/.venv/
Backend_Server/env/

